{
    "description": "TSOFT AI Dev Kit - medicion de tokens, evidencia y duracion de sesion.",
    "hooks": {
        "SubagentStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 \".codex/hooks/subagent_start.py\"",
                        "commandWindows": "py -3 \".codex\\hooks\\subagent_start.py\"",
                        "statusMessage": "Abriendo registro de subagente",
                        "timeout": 15
                    }
                ]
            }
        ],
        "SubagentStop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 \".codex/hooks/subagent_stop.py\"",
                        "commandWindows": "py -3 \".codex\\hooks\\subagent_stop.py\"",
                        "statusMessage": "Cerrando metricas del subagente",
                        "timeout": 30
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 \".codex/hooks/session_start.py\"",
                        "commandWindows": "py -3 \".codex\\hooks\\session_start.py\"",
                        "statusMessage": "Abriendo registro TSOFT AI Dev Kit",
                        "timeout": 20,
                        "additionalContextLimit": 3000
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 \".codex/hooks/user_prompt_submit.py\"",
                        "commandWindows": "py -3 \".codex\\hooks\\user_prompt_submit.py\"",
                        "statusMessage": "Clasificando tarea",
                        "timeout": 15,
                        "additionalContextLimit": 1500
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Bash|shell_command|apply_patch|Edit|Write|Agent|Task|parallel|multi_tool_use\\.parallel|mcp__.*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 \".codex/hooks/post_tool_use.py\"",
                        "commandWindows": "py -3 \".codex\\hooks\\post_tool_use.py\"",
                        "timeout": 15
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 \".codex/hooks/turn_stop.py\"",
                        "commandWindows": "py -3 \".codex\\hooks\\turn_stop.py\"",
                        "statusMessage": "Cerrando metricas y generando reporte",
                        "timeout": 60
                    }
                ]
            }
        ],
        "SessionEnd": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 \".codex/hooks/session_end.py\"",
                        "commandWindows": "py -3 \".codex\\hooks\\session_end.py\"",
                        "timeout": 3
                    }
                ]
            }
        ]
    }
}
